# Copy to .env and fill in values. Never commit .env.

APP_ENV=development
PORT=8091

# SQLite database file path
DATABASE_PATH=./frejaid.db

# Security — generate with: openssl rand -hex 32
SESSION_SECRET=changeme

# WebAuthn
# RPID must match the domain users visit (no port, no scheme)
WEBAUTHN_RPID=localhost
WEBAUTHN_RPORIGIN=http://localhost:8091
WEBAUTHN_RPDISPLAYNAME=FrejaID Demo

# App base URL (used for email links)
APP_BASE_URL=http://localhost:8091

# Bootstrap admin — comma-separated email(s) that are auto-approved as admin on first registration
# ADMIN_EMAIL=you@example.com

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
